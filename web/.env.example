APP_NAME=Loft
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite is fine for local development (touch database/database.sqlite). Use Postgres in production.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=loft
# DB_USERNAME=loft
# DB_PASSWORD=

SESSION_DRIVER=database
# Behind a load balancer that terminates HTTPS (Render, Fly…), trust its X-Forwarded-* headers:
# TRUSTED_PROXIES=*
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log writes emails to storage/logs. To send with Resend: MAIL_MAILER=resend and RESEND_API_KEY=re_...
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Studio emails are sent from this address with the studio's name; replies go to the studio.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe Connect (see README.md → Payments). Test keys until launch.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# STRIPE_API_VERSION=2024-06-20
# Share of each studio payment kept by the platform, e.g. 1.5. 0 = none.
LOFT_PLATFORM_FEE_PERCENT=0

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

